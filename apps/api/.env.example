DATABASE_URL="postgresql://user:password@localhost:5432/dineiz_supply?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
# Required (hard-fails on boot) once NODE_ENV=production — never ship the
# default above. Generate one with: openssl rand -hex 32
CORS_ORIGIN="http://localhost:3000"
# Comma-separated for multiple origins in production, e.g.:
# CORS_ORIGIN="https://app.example.com,https://www.example.com"
PORT=4000
NODE_ENV=development
