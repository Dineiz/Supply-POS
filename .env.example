# ==========================================
# Dineiz Supply - Environment Variables Example
# ==========================================

# 1. Database (PostgreSQL / Neon DB)
# When using Neon DB, append ?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"

# 2. Authentication (API)
# Must be a 32+ character random string in production (e.g. openssl rand -hex 32)
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-string"

# 3. CORS Configuration (API)
# Comma-separated allowed frontend domains in production (e.g. "https://your-dashboard.vercel.app")
CORS_ORIGIN="http://localhost:3000"

# 4. Server Configuration (API)
PORT=4000
NODE_ENV=development

# 5. Frontend Configuration (Web / Next.js)
# URL of your API backend without trailing slash (e.g. "https://your-api.up.railway.app")
NEXT_PUBLIC_API_URL="http://localhost:4000"
